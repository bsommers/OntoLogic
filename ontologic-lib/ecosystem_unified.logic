;; ============================================================================
;; TIER 4: Unified Ecosystem Mega-Ontology
;; Unifying BFO 2020, CCO, Autonomous AI (AI-MAS), Software Systems (SE),
;; Cybersecurity (STIX/ATT&CK/D3FEND/OCSF/SIGMA), and Dark Software Factory (DSF)
;; ============================================================================

(import "autonomous_ai.logic")
(import "software_systems.logic")
(import "sigma_rules.logic")
(import "mitre_d3fend.logic")
(import "factory_domain.logic")

(namespace eco "http://bsommers.github.io/ontologic/ecosystem_unified#")

;; ----------------------------------------------------------------------------
;; 1. Unified Enterprise Architecture Concepts
;; ----------------------------------------------------------------------------
(def-concept eco:AutonomousFactorySystem cco:EngineeredSystem)
(def-concept eco:SecureAutonomousSDLC cco:PlannedProcess)
(def-concept eco:AgenticDevOpsSwarm ai:AgentSwarm)
(def-concept eco:RepositoryAuditTask cco:ActOfVerification)
(def-concept eco:SecurityGateEvaluation ai:QualityGate)

;; ----------------------------------------------------------------------------
;; 2. Cross-Domain Enterprise Relations
;; ----------------------------------------------------------------------------
;; Factory -> AI Swarm integration
(def-relation eco:operates_swarm dsf:SoftwareFactory ai:AgentSwarm)

;; AI Agent -> Software Engineering repository operations
(def-relation eco:authors_code ai:AutonomousAgent se:SourceFile)
(def-relation eco:inspects_repository ai:AutonomousAgent se:Repository)
(def-relation eco:triggers_pipeline ai:AutonomousAgent se:CIPipelineExecution)

;; CI/CD -> Quality Gates & Security Controls
(def-relation eco:enforces_quality_gate se:CIPipelineExecution ai:QualityGate)
(def-relation eco:mitigated_by_countermeasure stix:Vulnerability d3f:DefensiveTechnique)
(def-relation eco:monitored_by_rule se:CIPipelineExecution sigma:SigmaRule)
(def-relation eco:evaluates_repository eco:RepositoryAuditTask se:Repository)

;; ----------------------------------------------------------------------------
;; 3. Unified Operational Properties
;; ----------------------------------------------------------------------------
(def-property eco:security_compliance_score eco:SecurityGateEvaluation Float)
(def-property eco:deployment_frequency_per_day eco:AutonomousFactorySystem Integer)
(def-property eco:is_autonomous_mode eco:AutonomousFactorySystem Boolean)

;; ----------------------------------------------------------------------------
;; 4. Cross-Domain First-Order Logic Axioms
;; ----------------------------------------------------------------------------
(def-axiom "Security compliance score is percentage bounded between 0 and 100"
  (forall (g)
    (implies (eco:SecurityGateEvaluation g)
             (and (gte eco:security_compliance_score 0.0)
                  (lte eco:security_compliance_score 100.0)))))

(def-axiom "Autonomous factory system has positive daily deployment frequency"
  (forall (f)
    (implies (eco:AutonomousFactorySystem f)
             (gt eco:deployment_frequency_per_day 0))))
