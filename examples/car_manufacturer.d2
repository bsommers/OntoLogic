"Vehicle" -> "Asset"
"SUV" -> "Vehicle"
"Sedan" -> "Vehicle"
"Truck" -> "Vehicle"
"Equipment" -> "Asset"
"Station" -> "Equipment"
"Robot" -> "Equipment"
"WeldingRobot" -> "Robot"
"PaintingRobot" -> "Robot"
"AssemblyRobot" -> "Robot"
"Scanner" -> "Equipment"
"OpticalScanner" -> "Scanner"
"LaserScanner" -> "Scanner"
"BluewristScanner" -> "LaserScanner"
"SafetySystem" -> "Equipment"
"LightCurtain" -> "SafetySystem"
"Vehicle"."vin": String
"Vehicle"."model_year": Integer
"Vehicle"."weld_count": Integer
"Vehicle"."is_painted": Boolean
"Vehicle"."is_quality_approved": Boolean
"Vehicle"."paint_color": String
"Station"."station_id": String
"Equipment"."is_active": Boolean
"Equipment"."temperature": Integer
"Robot"."current_job": String
"Scanner"."defect_detected": Boolean
"Scanner"."scan_resolution_microns": Integer
"SafetySystem"."barrier_active": Boolean
