(def-concept NetworkNode)
(def-concept TrustedNode NetworkNode)
(def-concept UntrustedNode NetworkNode)

(def-relation can_access NetworkNode NetworkNode)

; The protected resource must be declared, or the axiom below cannot be sent to the solver.
(def-individual AdminPanel NetworkNode)

; Logic: UntrustedNodes cannot communicate with the AdminPanel
(forall (n) 
    (implies (UntrustedNode n) 
        (not (can_access n AdminPanel))))
