{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OntoLogic",
  "scopeName": "source.ontologic",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#options"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#concepts"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.ontologic",
          "match": ";.*$"
        },
        {
          "name": "comment.line.double-slash.ontologic",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ontologic",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.block.lisp.ontologic",
          "begin": "#\\|",
          "end": "\\|#"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ontologic",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ontologic",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ontologic",
          "match": "-?\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.ontologic",
          "match": "-?\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.ontologic",
          "match": "(?<![\\w:.-])(def-concept|def-property|def-relation|def-individual|def-axiom|namespace|import)(?![\\w:.-])"
        },
        {
          "name": "keyword.control.quantifier.ontologic",
          "match": "(?<![\\w:.-])(forall|exists)(?![\\w:.-])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.ontologic",
          "match": "(?<![\\w:.-])(and|or|not|implies|if|iff)(?![\\w:.-])"
        },
        {
          "name": "keyword.operator.comparison.ontologic",
          "match": "(?<![\\w:.-])(gt|gte|lt|lte|eq|ne)(?![\\w:.-])|(?<=\\()\\s*(=|!=)(?=\\s)"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ontologic",
          "match": "\\b(String|Integer|Float|Double|Boolean)\\b"
        }
      ]
    },
    "concepts": {
      "patterns": [
        {
          "name": "entity.name.type.class.ontologic",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.property.ontologic",
          "match": "\\b[a-z][a-zA-Z0-9_\\-]*\\b"
        }
      ]
    },
    "options": {
      "patterns": [
        {
          "name": "keyword.other.option.ontologic",
          "match": "(?<![\\w-]):(cardinality|optional|default)(?![\\w-])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.ontologic",
          "match": "(?<![\\w:.-])(true|false|True|False|top|bottom|Top|Bottom)(?![\\w:.-])"
        }
      ]
    }
  }
}
